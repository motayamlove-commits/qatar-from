# Copy this file to .env (locally) or set the same variables in Railway.
# Never commit real values to the repository.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Email (Brevo) ---
# REST API (preferred — works on Railway)
BREVO_API_KEY=
# Sender shown on outgoing emails
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=قطر للسياحة

# SMTP fallback (local testing only; blocked on Railway)
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# --- Admin notifications ---
# Project manager / booth manager who receives payment & OTP notifications
ADMIN_EMAIL=

# --- Acceptance email delay ---
# Seconds to wait before sending the customer acceptance/payment email.
# 0 = send immediately. Use 180 (3 minutes) or 300 (5 minutes) to delay.
ACCEPTANCE_EMAIL_DELAY_SECONDS=180
